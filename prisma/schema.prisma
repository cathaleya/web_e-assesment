generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(uuid())
  username        String?
  email           String     @unique
  passwordHash    String?
  role            String     @default("STUDENT") // ADMIN | STUDENT
  gender          String?    // M | F
  institution     String?
  createdAt       DateTime   @default(now())
  responses       Response[]
}

model Instrument {
  id              String           @id @default(uuid())
  title           String
  version         String
  filePath        String?          // Path to JSON/CSV
  isActive        Boolean          @default(true)
  uploadedAt      DateTime         @default(now())
  items           Item[]
  analysisResults AnalysisResult[]
}

model Item {
  id              String     @id @default(uuid())
  instrumentId    String
  instrument      Instrument @relation(fields: [instrumentId], references: [id])
  itemCode        String     // e.g., ITEM_01
  prompt          String     @db.Text
  dimension       String     // INFO | CREATE | PEDAGOGY | ETHICS
  maxScore        Int        @default(3) // For Partial Credit Model
  metadata        Json?      // Rubric, Options, etc.
  responses       Response[]
}

model Response {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  itemId          String
  item            Item     @relation(fields: [itemId], references: [id])
  answerText      String   @db.Text
  rawScore        Int      @default(0) // Polytomous score
  aiFeedback      String?  @db.Text
  abilityEstimate Float?   // Theta from IRT/PCM
  submittedAt     DateTime @default(now())
}

model AnalysisResult {
  id              String     @id @default(uuid())
  instrumentId    String
  instrument      Instrument @relation(fields: [instrumentId], references: [id])
  analysisType    String     // EFA | CFA | PCM | DIF
  resultData      Json       // Fit indices, DIF statistics
  chartPath       String?    // Path to generated plot image
  computedAt      DateTime   @default(now())
}
